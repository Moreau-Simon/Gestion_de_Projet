# Configuration générale de l'application
PROJECT_NAME="SaaS Project Management API"
ENV=development

# Connexion MongoDB
# Format standard URI compatible standalone, Replica Set et Sharding Router (mongos)
# Exemples :
# Standalone local : mongodb://mongodb:27017
# Replica Set : mongodb://mongo1:27017,mongo2:27017,mongo3:27017/?replicaSet=rs0
# Sharded Cluster (mongos) : mongodb://mongos1:27017,mongos2:27017
MONGO_URI=mongodb://mongodb:27017
MONGO_DB_NAME=saas_pm_db

# Sécurité & Authentification JWT
# ATTENTION : Générer une clé secrète aléatoire et forte en production (ex: openssl rand -hex 32)
JWT_SECRET_KEY=dev_secret_key_change_in_production_9f8d7e6c5b4a321
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
